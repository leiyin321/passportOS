{
  "format": "passport.app/1",
  "id": "org.passport.city-radio",
  "name": "City Radio",
  "version": "0.1.2",
  "runtime": "native-elf",
  "entry": "app.app.elf",
  "target": "esp32c3",
  "abi": 2,
  "trusted": true,
  "min_os_api": 1,
  "data_schema": 1,
  "permissions": [
    "ui",
    "graphics",
    "input",
    "timer",
    "storage.private",
    "network.fetch",
    "audio.playback",
    "audio.http"
  ],
  "domains": [
    "lhttp.qingting.fm",
    "lhttp.qtfm.cn"
  ],
  "limits": {
    "native_exec_kib": 16,
    "fps": 10,
    "persistent_kib": 1
  },
  "display": {
    "mode": "standard",
    "orientation": "portrait",
    "navigation": "buttons"
  },
  "icon": "system.app-default"
}
